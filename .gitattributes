# Force LF line endings for all text files
* text=auto eol=lf

# Explicit text formats
*.md       text eol=lf
*.json     text eol=lf
*.py       text eol=lf
*.sh       text eol=lf
*.yaml     text eol=lf
*.yml      text eol=lf
LICENSE    text eol=lf

# Windows-only files (if any) should stay CRLF
*.ps1      text eol=crlf
*.bat      text eol=crlf
*.cmd      text eol=crlf
