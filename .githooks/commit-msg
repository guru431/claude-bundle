#!/bin/sh
# commit-msg secret-guard for a PUBLIC repository.
#
# The third channel to the remote, and the one nothing watched. pre-commit scans
# the staged DIFF and pre-push scans the BLOBS being published — a token pasted
# into a commit message went through both untouched and reached the remote in
# plain text, where `git log` shows it to everyone forever.
#
# Activate once per clone:   git config core.hooksPath .githooks
#                            (scripts/enable-guard.sh does it for you)
# Bypass a confirmed false positive:   git commit --no-verify
set -eu

msg_file="${1:-}"
[ -n "$msg_file" ] && [ -f "$msg_file" ] || exit 0

repo_root=$(git rev-parse --show-toplevel)
lib="$repo_root/home-claude/cron/lib/secret-scan.sh"
if [ ! -f "$lib" ]; then
  # Fail CLOSED, like pre-push: "the guard is missing" must never resolve to
  # "the guard passed" on a repository that is meant to be published.
  echo "BLOCKED: $lib not found — the commit-message scan cannot run." >&2
  echo "Restore it, or commit with --no-verify if you have checked by hand." >&2
  exit 1
fi
# shellcheck source=/dev/null
. "$lib"

fail=0

# Which lines git keeps depends on the cleanup mode, and the hook is not told it.
# `#` lines are stripped only when the message is edited in the editor
# (cleanup=strip). With `git commit -F` or `-m` — the usual way a script or an
# agent writes a multi-line message — cleanup=whitespace applies and a `#` line
# is stored as written; the old blanket `grep -v '^#'` never read it. The editor
# mode is recognised by the hint git itself puts into the template:
#   "with '#' will be ignored" — the `#` lines (status, Author:, the hint) are
#     dropped, so they are not scanned: the template would match every time;
#   "... will be kept" / "will be ignored" — everything under the scissors line
#     (`commit -v`, --cleanup=scissors) is dropped by git as well.
# No hint (-F, -m, a localised git) — everything is scanned: a false alarm here
# is cheaper than a token in the history.
#
# Decode BEFORE looking for the hint: an editor configured for UTF-16 (the
# default of `>` and `Out-File` in Windows PowerShell 5.1) writes a message whose
# BOM and NUL-interleaved bytes make every grep below see either binary or
# nothing. -a: GNU grep drops a line it cannot decode, and a message line
# carrying a CP1251 word and a token would have vanished before the scan.
#
# rc 1 from grep — every line was a comment, the body is empty; rc 2 — grep did
# not run, and an empty body would then be scanned as "clean". The decode is
# buffered separately so its own failure is read too.
if ! decoded=$(secret_scan_decode < "$msg_file"); then
  echo "BLOCKED: the commit message could not be read — it was NOT scanned."
  exit 1
fi
body=$decoded
if printf '%s\n' "$decoded" | grep -qE "^# (Lines starting )?with '#' will be (ignored|kept)"; then
  body=$(printf '%s\n' "$decoded" | sed '/^# -* >8 -*$/,$d')
fi
if printf '%s\n' "$decoded" | grep -qE "^# (Lines starting )?with '#' will be ignored"; then
  cm_rc=0
  body=$(printf '%s\n' "$body" | grep -av '^#') || cm_rc=$?
  if [ "$cm_rc" -gt 1 ]; then
    echo "BLOCKED: grep failed (rc $cm_rc) — the commit message was NOT scanned."
    exit 1
  fi
fi

if ! hits=$(printf '%s\n' "$body" | secret_scan_text); then
  echo "BLOCKED: possible secret/token format in the commit message:"
  printf '%s\n' "$hits" | sed 's/^/  /'
  fail=1
fi

# Personal denylist — the same untracked .sanitize-patterns the other two hooks
# read. A hostname or a username belongs out of a public commit message just as
# much as out of a file. One that exists but cannot be used blocks.
pat=$(mktemp 2>/dev/null || echo "$repo_root/.sanitize-patterns.tmp")
if ! secret_scan_denylist "$repo_root/.sanitize-patterns" "$pat"; then
  echo "BLOCKED: .sanitize-patterns cannot be used (see above) — the personal denylist"
  echo "  would be OFF for this message. Fix the pattern, or move the file aside."
  fail=1
elif [ -s "$pat" ]; then
  # The body is already decoded text, so a plain grep is the whole check — one
  # ERE rather than `-f` (GNU grep 3.0 aborts on `-i` with `-f`), status read.
  dl_rc=0
  hits=$(printf '%s\n' "$body" | grep -naiE -e "$(secret_scan_denylist_ere "$pat")") || dl_rc=$?
  if [ "$dl_rc" -gt 1 ]; then
    hits="scan-error: grep failed (rc $dl_rc), the message was NOT checked"
  fi
  if [ -n "$hits" ]; then
    echo "BLOCKED: personal data (matched .sanitize-patterns) in the commit message:"
    printf '%s\n' "$hits" | sed 's/^/  /'
    fail=1
  fi
fi
rm -f "$pat"

if [ "$fail" -ne 0 ]; then
  echo ""
  echo "Commit aborted — this is a PUBLIC repository, and a commit message is"
  echo "published exactly as written. Rewrite the message above, or for a"
  echo "confirmed false positive: git commit --no-verify"
  exit 1
fi
exit 0
