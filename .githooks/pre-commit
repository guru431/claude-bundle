#!/bin/sh
# pre-commit secret-guard for a PUBLIC repository.
# Blocks commits that add sensitive files, high-entropy key formats, or
# personal strings listed in an untracked .sanitize-patterns file.
#
# Activate once per clone:   git config core.hooksPath .githooks
# Bypass a confirmed false positive:   git commit --no-verify
set -eu

repo_root=$(git rev-parse --show-toplevel)
fail=0

# The shared library is sourced FIRST: every step below uses its tables and
# helpers. Three hand-written copies of the sensitive-path list used to exist
# (here, github-push.sh, git-push-all.sh) and they disagreed — `.env.example`
# was blocked by one and waved through by another, while `credentials.json`,
# `.npmrc`, `.netrc`, `.pypirc`, `*.ppk`, `*.jks`, `id_ecdsa`,
# `.git-credentials` and `terraform.tfstate` were known to none.
lib="$repo_root/home-claude/cron/lib/secret-scan.sh"
if [ ! -f "$lib" ]; then
  # Fail CLOSED, like commit-msg and pre-push. This hook used to print a
  # WARNING and let the commit through with the token scan switched off — the
  # guard that runs first was the one that did not hold, while
  # docs/decisions.md (D-10) says a missing library blocks the commit.
  echo "BLOCKED: $lib not found — the secret scan cannot run." >&2
  echo "Restore it, or commit with --no-verify if you have checked by hand." >&2
  exit 1
fi
# shellcheck source=/dev/null
. "$lib"

# 1) Block sensitive filenames being newly added (allow *.example* templates)
# --diff-filter=AR: a rename (`git mv safe.txt .env`) is an R, not an A.
# secret_scan_git_paths, not a bare `--name-only`: git quotes a non-ASCII path by
# default (`"\320\277…/.env"`), and the name table never matched the quoted form.
added=$(secret_scan_git_paths diff --cached --name-only --diff-filter=AR || true)
if [ -n "$added" ] && ! bad=$(printf '%s\n' "$added" | secret_scan_paths); then
  echo "BLOCKED: refusing to commit sensitive file(s):"
  printf '%s\n' "$bad" | sed 's/^/  /'
  fail=1
fi

# Collect staged diff once (exclude the hook itself to avoid self-matching)
diff_content=$(git -c core.quotePath=false diff --cached --unified=0 -- . ':(exclude).githooks/' 2>/dev/null \
  || git -c core.quotePath=false diff --cached --unified=0)
# ADDED lines only, for the same reason secret_scan_diff filters them: a commit
# that REMOVES a leaked string must not be blocked, or the leak could never be
# remediated. Step 3 below used to grep the whole diff, '-' lines included — so
# the one commit that cleans a hostname out of the tree matched its own
# denylist and was refused, leaving `--no-verify` (which also disables step 2)
# as the only way through. '+++' is a file header, not content.
added_content=$(printf '%s\n' "$diff_content" | grep -aE '^\+' | grep -avE '^\+\+\+' || true)

# The personal denylist is read HERE rather than in step 3, because step 2b
# below needs it too — a UTF-16 file has to be checked against both tables in
# the one pass that can read it. A denylist that exists but cannot be used
# blocks: letting the commit through would mean checking it against nothing.
pat=$(mktemp 2>/dev/null || echo "$repo_root/.sanitize-patterns.tmp")
if ! secret_scan_denylist "$repo_root/.sanitize-patterns" "$pat"; then
  echo "BLOCKED: .sanitize-patterns cannot be used (see above) — the personal denylist"
  echo "  would be OFF for this commit. Fix the pattern, or move the file aside."
  fail=1
fi

# 2) High-confidence secret/token formats (generic, very low false-positive)
# Shared with the nightly cron/git-push-all.sh sweep — one source of truth for
# the regex lives in home-claude/cron/lib/secret-scan.sh (already sourced above).
hits=$(printf '%s\n' "$diff_content" | secret_scan_diff || true)
if [ -n "$hits" ]; then
  echo "BLOCKED: possible secret/token format in staged changes:"
  printf '%s\n' "$hits" | sed 's/^/  /'
  fail=1
fi

# 2b) UTF-16 staged files. `git diff` calls them binary and prints "Binary files
# differ" instead of a single `+` line, so steps 2 and 3 read NOTHING for them —
# and UTF-16 is what `>` and `Out-File` produce by default in Windows
# PowerShell 5.1, the shell this bundle is written for. A key pasted into such a
# file was invisible to every one of the three detectors. Here the STAGED
# content is read whole and decoded before either table is applied.
staged_names=$(secret_scan_git_paths diff --cached --name-only --diff-filter=ACMR -- . ':(exclude).githooks/' 2>/dev/null || true)
u16_hits=$(printf '%s\n' "$staged_names" | while IFS= read -r f; do
  [ -n "$f" ] || continue
  bom=$(git show ":$f" 2>/dev/null | od -An -tx1 -N2 | tr -d ' \n')
  case "$bom" in fffe|feff) ;; *) continue ;; esac
  if ! h=$(git show ":$f" 2>/dev/null | secret_scan_text); then
    printf '%s: %s\n' "$f" "$h"
  fi
  if [ -s "$pat" ] && ! h=$(git show ":$f" 2>/dev/null | secret_scan_denylist_text "$pat"); then
    printf '%s: %s\n' "$f" "$h"
  fi
done || true)
if [ -n "$u16_hits" ]; then
  echo "BLOCKED: possible secret or personal data in a staged UTF-16 file:"
  printf '%s\n' "$u16_hits" | sed 's/^/  /'
  fail=1
fi

# 3) Personal denylist — concrete values from untracked .sanitize-patterns
# A plain grep: diff lines are text by construction (UTF-16 and binary files
# never get `+` lines; step 2b reads the UTF-16 ones), so the decoding scanner
# would only add process spawns to every commit. -a for the reason
# secret_scan_diff gives.
if [ -s "$pat" ]; then
  hits=$(printf '%s\n' "$added_content" | grep -naiEf "$pat" || true)
  if [ -n "$hits" ]; then
    echo "BLOCKED: personal data (matched .sanitize-patterns) in staged changes:"
    printf '%s\n' "$hits" | sed 's/^/  /'
    fail=1
  fi
fi
rm -f "$pat"

if [ "$fail" -ne 0 ]; then
  echo ""
  echo "Commit aborted — this is a PUBLIC repository."
  echo "Fix the lines above, or for a confirmed false positive: git commit --no-verify"
  exit 1
fi
exit 0
