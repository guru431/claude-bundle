#!/bin/sh
# pre-commit secret-guard for a PUBLIC repository.
# Blocks commits that add sensitive files, high-entropy key formats, or
# personal strings listed in an untracked .sanitize-patterns file.
#
# Activate once per clone:   git config core.hooksPath .githooks
# Bypass a confirmed false positive:   git commit --no-verify
set -eu

repo_root=$(git rev-parse --show-toplevel)
fail=0

# The shared library is sourced FIRST: every step below uses its tables and
# helpers. Three hand-written copies of the sensitive-path list used to exist
# (here, github-push.sh, git-push-all.sh) and they disagreed — `.env.example`
# was blocked by one and waved through by another, while `credentials.json`,
# `.npmrc`, `.netrc`, `.pypirc`, `*.ppk`, `*.jks`, `id_ecdsa`,
# `.git-credentials` and `terraform.tfstate` were known to none.
lib="$repo_root/home-claude/cron/lib/secret-scan.sh"
if [ ! -f "$lib" ]; then
  # Fail CLOSED, like commit-msg and pre-push. This hook used to print a
  # WARNING and let the commit through with the token scan switched off — the
  # guard that runs first was the one that did not hold, while
  # docs/decisions.md (D-10) says a missing library blocks the commit.
  echo "BLOCKED: $lib not found — the secret scan cannot run." >&2
  echo "Restore it, or commit with --no-verify if you have checked by hand." >&2
  exit 1
fi
# shellcheck source=/dev/null
. "$lib"

# 1) Block sensitive filenames being newly added (allow *.example* templates)
# --diff-filter=AR: a rename (`git mv safe.txt .env`) is an R, not an A.
# secret_scan_git_paths, not a bare `--name-only`: git quotes a non-ASCII path by
# default (`"\320\277…/.env"`), and the name table never matched the quoted form.
# A git that could not list the names is a block, not "no new files".
if ! added=$(secret_scan_git_paths diff --cached --name-only --diff-filter=AR); then
  echo "BLOCKED: git could not list the staged file names — the name check did not run."
  added=""
  fail=1
fi
if [ -n "$added" ] && ! bad=$(printf '%s\n' "$added" | secret_scan_paths); then
  echo "BLOCKED: refusing to commit sensitive file(s):"
  printf '%s\n' "$bad" | sed 's/^/  /'
  fail=1
fi

# Collect staged diff once. `.githooks/` is scanned like everything else: it
# used to be excluded "to avoid self-matching" on the token table, and the
# exclusion took the personal denylist with it — yet the hooks are published
# with the rest of the repository, a host name written into one included.
# Neither table matches the hooks today; a line that must look like a token
# takes the per-line `secret-scan:allow` marker, like every detector fixture.
# A diff git could not produce blocks: an empty one would scan as "clean".
if ! diff_content=$(git -c core.quotePath=false diff --cached --unified=0); then
  echo "BLOCKED: git could not produce the staged diff — the content checks did not run."
  diff_content=""
  fail=1
fi
# ADDED lines only, for the same reason secret_scan_diff filters them: a commit
# that REMOVES a leaked string must not be blocked, or the leak could never be
# remediated. Step 3 below used to grep the whole diff, '-' lines included — so
# the one commit that cleans a hostname out of the tree matched its own
# denylist and was refused, leaving `--no-verify` (which also disables step 2)
# as the only way through. '+++' is a file header, not content.
# One awk and its status read: two greps behind `|| true` turned a failed grep
# into "nothing added", and the denylist pass below then read nothing.
if ! added_content=$(printf '%s\n' "$diff_content" | awk '/^\+/ && !/^\+\+\+/'); then
  echo "BLOCKED: the added lines could not be extracted — the denylist check did not run."
  fail=1
fi

# The personal denylist is read HERE rather than in step 3, because step 2b
# below needs it too — a binary or UTF-16 file has to be checked against both
# tables in the one pass that can read it. A denylist that exists but cannot be used
# blocks: letting the commit through would mean checking it against nothing.
pat=$(mktemp 2>/dev/null || echo "$repo_root/.sanitize-patterns.tmp")
if ! secret_scan_denylist "$repo_root/.sanitize-patterns" "$pat"; then
  echo "BLOCKED: .sanitize-patterns cannot be used (see above) — the personal denylist"
  echo "  would be OFF for this commit. Fix the pattern, or move the file aside."
  fail=1
fi

# 2) High-confidence secret/token formats (generic, very low false-positive)
# Shared with the nightly cron/git-push-all.sh sweep — one source of truth for
# the regex lives in home-claude/cron/lib/secret-scan.sh (already sourced above).
hits=$(printf '%s\n' "$diff_content" | secret_scan_diff || true)   # rc-ok: the verdict is the output — a hit or a scan-error line
if [ -n "$hits" ]; then
  echo "BLOCKED: possible secret/token format in staged changes:"
  printf '%s\n' "$hits" | sed 's/^/  /'
  fail=1
fi

# 2b) Staged files git calls BINARY. `git diff` prints "Binary files differ"
# for them instead of a single `+` line, so steps 2 and 3 read NOTHING of them.
# UTF-16 is one such case — what `>` and `Out-File` produce by default in
# Windows PowerShell 5.1, the shell this bundle is written for — and this step
# used to read those alone, sniffing the BOM of EVERY staged file with three
# process spawns apiece. Every other binary file (a SQLite database, a
# serialized cache) went into the commit unread, while pre-push, which scans
# binary blobs, would have stopped the same content one step later.
# secret_scan_changed_binaries picks the binary files out with one
# `git diff --numstat` and reads each one whole, decoded, against both tables.
if ! bin_hits=$(secret_scan_changed_binaries index "$pat"); then
  echo "BLOCKED: possible secret or personal data in a staged binary or UTF-16 file:"
  printf '%s\n' "$bin_hits" | sed 's/^/  /'
  fail=1
fi

# 3) Personal denylist — concrete values from untracked .sanitize-patterns
# A plain grep: diff lines are text by construction (UTF-16 and binary files
# never get `+` lines; step 2b reads those), so the decoding scanner would only
# add process spawns to every commit. -a for the reason secret_scan_diff gives.
if [ -s "$pat" ]; then
  # One ERE, not `grep -f`: GNU grep 3.0 (Git for Windows) aborts (rc 134) on
  # `-i` together with `-f` — see secret_scan_denylist_ere in the library. And
  # the status read: rc 2 or 134 is "not checked", never "no match".
  dl_rc=0
  hits=$(printf '%s\n' "$added_content" \
    | grep -naiE -e "$(secret_scan_denylist_ere "$pat")") || dl_rc=$?
  if [ "$dl_rc" -gt 1 ]; then
    hits="scan-error: grep failed (rc $dl_rc), the staged changes were NOT checked"
  fi
  if [ -n "$hits" ]; then
    echo "BLOCKED: personal data (matched .sanitize-patterns) in staged changes:"
    printf '%s\n' "$hits" | sed 's/^/  /'
    fail=1
  fi
fi
rm -f "$pat"

if [ "$fail" -ne 0 ]; then
  echo ""
  echo "Commit aborted — this is a PUBLIC repository."
  echo "Fix the lines above, or for a confirmed false positive: git commit --no-verify"
  exit 1
fi
exit 0
