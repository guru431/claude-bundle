# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/
.idea/
*.swp
*~

# Backups created by install
*.bak
*.bak-*

# Local overrides (user-specific examples, not part of the bundle)
local/

# Env files — the only committed env template is config/llm-providers.example.env
.env
.env.*

# Machine-local pipeline manifest (real project-dir names = personal). The only
# committed template is config/bundle.local.example.yaml.
bundle.local.yaml
home-claude/bundle.local.yaml

# Local sanitization patterns — see CLAUDE.md § Sanitization checklist.
# This file itself is the leak it tries to prevent — never commit.
# (The * also covers the pre-commit hook's .sanitize-patterns.tmp fallback.)
.sanitize-patterns*

# A Claude Code workspace inside the bundle dir — local test artifacts only
.claude/

# Python bytecode
__pycache__/
*.pyc

# Runtime wiki state (generated by the cron pipeline; never part of the bundle)
.processed.json
.processed.json.tmp
.processed.json.lock
home-claude/wiki/log.md
home-claude/cron/logs/

# Agent-side backlog files (private to maintainer, never published)
FINDINGS.md
FINDINGS-archive.md
IDEAS.md
IDEAS-archive.md
