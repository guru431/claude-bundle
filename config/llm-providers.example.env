# LLM provider configuration — example
#
# Copy this file to <bundle-root>/.env (or set in your shell environment).
# The bundle itself NEVER commits an .env file (see .gitignore).
#
# Components that read these:
#   - scripts/claude-switch.ps1            (anthropic / deepseek / minimax / opencode / ccr)
#   - home-claude/cron/hooks/utils.py      (wiki + cron LLM calls)
#   - home-claude/cron/telegram-send.sh    (alerts)
#
# Minimal viable setup for the wiki+cron pipeline:
#   - At least one of: DEEPSEEK_KEY, OPENCODE_GO_API_KEY
#   - TELEGRAM_BOT_TOKEN + TELEGRAM_CHAT_ID (for failure alerts)
#
# Where to get each key:
#   DEEPSEEK_KEY         https://platform.deepseek.com — PAYG, ~$0.27/M input
#                        tokens for V4-Flash; the cheapest reliable provider
#                        for the wiki pipeline at the time of writing
#   OPENCODE_GO_API_KEY  https://opencode.ai — flat-rate subscription that
#                        bundles many models (Kimi, GLM, MiniMax, Qwen, ...)
#   MINIMAX_API_KEY      https://api.minimax.io — direct billing, lower
#                        latency than OpenCode Go for MiniMax models
#   ANTHROPIC_API_KEY    https://console.anthropic.com (or OAuth via
#                        `claude /login`; key is not strictly needed for
#                        the "anthropic" mode of claude-switch)
#   CCR_API_KEY          your own Claude Code Router shared secret
#                        (set in ~/.claude-code-router/config.json)
#   TELEGRAM_BOT_TOKEN   create a bot via @BotFather on Telegram
#   TELEGRAM_CHAT_ID     your own chat_id (send /start to your bot,
#                        then call getUpdates to read the chat.id)

# ──────────────────────────────────────────────────────────────────
# LLM provider keys
# ──────────────────────────────────────────────────────────────────

# DeepSeek — primary provider for wiki + cron LLM calls
DEEPSEEK_KEY=

# OpenCode Go — fallback for wiki + cron, primary for some claude-switch modes
OPENCODE_GO_API_KEY=

# MiniMax direct (optional, only needed for claude-switch minimax mode)
MINIMAX_API_KEY=

# Anthropic (optional, OAuth via `claude /login` usually suffices)
ANTHROPIC_API_KEY=

# Claude Code Router shared secret (optional, only if you run CCR)
CCR_API_KEY=
CCR_HOST=127.0.0.1:3456

# ──────────────────────────────────────────────────────────────────
# Wiki pipeline tuning (optional — sane defaults)
# ──────────────────────────────────────────────────────────────────

# Which provider to use for wiki + cron LLM calls
#   deepseek  — DeepSeek V4-Flash direct (primary, cheapest)
#   opencode  — OpenCode Go mimo-v2.5-pro (fallback)
#   claude    — claude CLI (consumes your Claude subscription; opt-in only)
WIKI_LLM_PROVIDER=deepseek

# Override default models if you want a different one
# DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# OPENCODE_GO_MODEL=mimo-v2.5-pro

# ──────────────────────────────────────────────────────────────────
# Telegram alerts (used by cron failures)
# ──────────────────────────────────────────────────────────────────

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
