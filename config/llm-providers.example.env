# LLM provider configuration — example
#
# Copy this file to ~/.claude/.env (next to the deployed cron/ and wiki/ —
# that is the ONE .env every component reads) or set the values in your
# shell environment. The bundle itself NEVER commits an .env file (see
# .gitignore).
#
# Components that read these:
#   - home-claude/cron/hooks/utils.py      (wiki + cron LLM calls)    ← ~/.claude/.env
#   - home-claude/cron/*.sh                (telegram, healthcheck,
#                                           git-push-all, task-monitor) ← ~/.claude/.env
#   - scripts/claude-switch.ps1            (anthropic / deepseek / minimax /
#                                           opencode / ollama / ccr)  ← .env next to
#                                           the script, then ~/.claude/.env
#
# Canonical provider registry for the cron side: home-claude/cron/hooks/utils.py
# (the PROVIDERS table). Routing details & the mirror table: docs/llm-routing.md.
# Keep env-var names below in sync with both.
#
# Minimal viable setup for the wiki+cron pipeline:
#   - At least one of: DEEPSEEK_KEY, OPENCODE_GO_API_KEY
#   - TELEGRAM_BOT_TOKEN + TELEGRAM_CHAT_ID (for failure alerts)
#
# Where to get each key:
#   DEEPSEEK_KEY         https://platform.deepseek.com — PAYG; the cheapest
#                        reliable provider for the wiki pipeline at the time
#                        of writing. Rates move — check the current V4-Flash
#                        price at https://api-docs.deepseek.com/quick_start/pricing/
#   OPENCODE_GO_API_KEY  https://opencode.ai — flat-rate subscription that
#                        bundles many models (Kimi, GLM, MiniMax, Qwen, ...)
#   DEEPINFRA_KEY        https://deepinfra.com — PAYG; optional last fallback,
#                        so one gateway outage does not blank a whole night
#   MINIMAX_API_KEY      https://api.minimax.io — direct billing, lower
#                        latency than OpenCode Go for MiniMax models
#   ANTHROPIC_API_KEY    https://console.anthropic.com (or OAuth via
#                        `claude /login`; key is not strictly needed for
#                        the "anthropic" mode of claude-switch)
#   CCR_API_KEY          your own Claude Code Router shared secret
#                        (set in ~/.claude-code-router/config.json)
#   TELEGRAM_BOT_TOKEN   create a bot via @BotFather on Telegram
#   TELEGRAM_CHAT_ID     your own chat_id (send /start to your bot,
#                        then call getUpdates to read the chat.id)

# ──────────────────────────────────────────────────────────────────
# LLM provider keys
# ──────────────────────────────────────────────────────────────────

# DeepSeek — primary provider for wiki + cron LLM calls
DEEPSEEK_KEY=

# OpenCode Go — fallback for wiki + cron, primary for some claude-switch modes.
# The shorter alias OPENCODE_GO_KEY is also accepted (OPENCODE_GO_API_KEY wins
# if both are set).
OPENCODE_GO_API_KEY=

# DeepInfra — last fallback in the cron chain (PAYG, OpenAI-compatible).
# Optional: without it the chain is DeepSeek → OpenCode Go → None.
DEEPINFRA_KEY=

# MiniMax direct (optional, only needed for claude-switch minimax mode)
MINIMAX_API_KEY=

# Anthropic (optional, OAuth via `claude /login` usually suffices)
ANTHROPIC_API_KEY=

# Claude Code Router shared secret (optional, only if you run CCR)
CCR_API_KEY=
# CCR host:port — leave empty to use the CCR default of 127.0.0.1:3456
CCR_HOST=

# Ollama host:port for the claude-switch "ollama" mode — leave empty to use
# the default of 127.0.0.1:11434. No API key needed: the mode sets a dummy
# ANTHROPIC_AUTH_TOKEN=ollama-local to override any stored OAuth session.
OLLAMA_HOST=

# ──────────────────────────────────────────────────────────────────
# Wiki pipeline tuning (optional — sane defaults)
# ──────────────────────────────────────────────────────────────────

# Which provider to use for wiki + cron LLM calls (leave empty for "deepseek").
# "deepseek" names the default CHAIN, not DeepSeek alone: empty and "deepseek"
# behave identically. Every other value pins that one provider, no fallback.
# To run DeepSeek with nothing behind it, set WIKI_OFFBOX_FALLBACK=0 below.
#   deepseek  — DeepSeek V4-Flash direct, then OpenCode Go, then DeepInfra
#   opencode  — OpenCode Go mimo-v2.5-pro (fallback)
#   local     — any OpenAI-compatible server on this machine (see below)
#   claude    — claude CLI (consumes your Claude subscription; opt-in only)
#   mock      — offline canned responses read from $WIKI_LLM_MOCK_RESPONSE
#               (no network / no key; used by tests/ and CI)
WIKI_LLM_PROVIDER=

# Override default models if you want a different one
# DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# OPENCODE_GO_MODEL=mimo-v2.5-pro
# DEEPINFRA_MODEL=deepseek-ai/DeepSeek-V3.1
# DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai

# A stronger model for the one job that EDITS files unattended
# (ClaudeAgentsMdSyncCheck). Unset = same model as everything else. It fires
# only when real drift is found, so a few expensive calls a month; do not point
# the whole pipeline at such a model — see docs/llm-routing.md on quota weight.
# AGENTS_SYNC_FIX_MODEL=

# ── Local-only pipeline (WIKI_LLM_PROVIDER=local) ──
# Point these at any OpenAI-compatible server running on this machine (Ollama,
# llama.cpp, LM Studio, vLLM, ...) and your session transcripts never leave the
# box. There is no default model — set LOCAL_LLM_MODEL explicitly, so a typo
# fails loudly instead of silently calling something you didn't mean.
# Most local servers ignore the bearer token; LOCAL_LLM_KEY is optional.
# LOCAL_LLM_BASE_URL must resolve to loopback, or the call is refused and
# nothing is sent — "local-only" is verified, not taken on trust. To use a
# trusted non-loopback server on your own LAN, name its host(s) here
# (comma-separated) so allowing it is an explicit decision.
# LOCAL_LLM_BASE_URL=http://localhost:11434/v1
# LOCAL_LLM_MODEL=
# LOCAL_LLM_KEY=
# LOCAL_LLM_ALLOWED_HOSTS=

# Set to 0 to forbid the off-box fallback. By default a failed DeepSeek call
# falls back to the OpenCode Go gateway — which means a local-only setup would
# ship the prompt off-box precisely when the local server hiccups. This makes
# "nothing leaves this machine" enforceable rather than incidental.
# WIKI_OFFBOX_FALLBACK=1

# Cross-process queue around every provider call (cron/state/.llm.lock). All the
# scheduled tasks share one provider account, so two overlapping runs rate-limit
# each other into HTTP 429s — and the schedule alone can't prevent that, because
# run durations drift. WAIT is how long a call waits for a slot before going
# anyway (fail-open: a 429 beats a silently skipped nightly job); STALE is when a
# lock counts as abandoned by a killed process. Seconds. Defaults 900 / 1800.
# WIKI_LLM_LOCK_WAIT=900
# WIKI_LLM_LOCK_STALE=1800

# How many days of cron/logs/*.{log,jsonl} the ClaudeLogRetention task keeps
# before pruning (weekly). Leave empty for the default of 30. Cumulative
# journals (runs.jsonl) are exempt — see KEEP_FOREVER in log-retention.py.
# WIKI_LOG_RETENTION_DAYS=30

# Shorter windows for the two session-derived artifacts, both pruned by the same
# weekly task. Quarantined raw payloads (cron/logs/rejected/) echo private
# session text; handoffs (projects/*/memory/handoff-*.md) are LLM summaries of a
# session, one per compaction, and SessionStart ignores them after 24h anyway.
# Leave empty for the default of 7 days each.
# WIKI_REJECTED_RETENTION_DAYS=7
# WIKI_HANDOFF_RETENTION_DAYS=7

# How many older, never-processed JSONL transcripts the nightly flush sweeps up
# per run (the "historical backlog"), on top of the last 48h. Leave empty for
# the default of 0 — backfilling history is opt-in, so a first run can't ship
# your whole transcript archive to the LLM before you've set allow_projects in
# bundle.local.yaml. Raise it once you're happy with the scope.
# WIKI_BACKLOG_MAX=50

# Set to 1 to let ClaudeMemoryUpdate also write cross-project notes. This is a
# SECOND LLM call per night, carrying user messages from two or more projects
# at once — so it roughly doubles what that task sends. Off by default.
# MEMORY_CROSS_NOTES=0

# How long the SessionStart hook waits for a handoff that PreCompact is still
# writing (seconds). 0 = never wait. Leave empty for the default of 20.
# HANDOFF_WAIT_SECONDS=20

# ──────────────────────────────────────────────────────────────────
# Telegram alerts (used by cron failures)
# ──────────────────────────────────────────────────────────────────

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ──────────────────────────────────────────────────────────────────
# Filesystem roots (required by a few cron tasks)
# ──────────────────────────────────────────────────────────────────

# Root folder that git-push-all.sh and md2pdf-sync.py sweep. BOTH tasks
# hard-refuse to run without this when the bundle is deployed at the
# documented default ~/.claude — so set it if you enable either task.
# Point it at the parent of your git repos / Markdown trees.
PROJECTS_ROOT=

# git-push-all.sh only: a process-name pattern to wait for before pushing (e.g.
# a nightly batch job that must finish first). Windows-only — the poll uses
# tasklist.exe; elsewhere the wait is skipped and logged. Empty = never wait.
# WAIT_FOR_PATTERN=

# Optional interpreter overrides for the cron tasks, when python / bash are
# not on PATH in the Task Scheduler environment. Leave empty to use PATH.
# (Also read by the bin/_run-hidden.vbs launcher for kind: bash|python tasks.)
PYTHON_EXE=
BASH_EXE=

# Path to the `claude` CLI for the ClaudeWarmWindow task, when it isn't on PATH
# in session 0 (before logon). Leave empty to resolve via PATH.
CLAUDE_BIN=

# ──────────────────────────────────────────────────────────────────
# Healthcheck remote hosts (optional — claude-healthcheck.sh)
# ──────────────────────────────────────────────────────────────────

# Leave BOTH empty (the default) and the healthcheck only reports the local
# host. Setting either one adds that machine's metrics to the prompt sent to
# your LLM provider every morning — hostnames and resource state included.
# See docs/cron-architecture.md ("What ClaudeHealthcheck actually sends").

# Remote Linux host checked over SSH. Must be an alias from ~/.ssh/config
# (credentials and port are handled there, not here).
REMOTE_SSH_HOST=

# Remote Windows host checked over WinRM. Must be in TrustedHosts.
WIN_REMOTE_HOST=

# Disk-usage percentage that turns the morning healthcheck into an alert. This
# is the pipeline's only deterministic (non-LLM) threshold. Values outside
# 0..100 are rejected with a warning in the log. Empty = the default of 85.
# HEALTHCHECK_DISK_PCT=85
