{
  "env": {},
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(where:*)",
      "Read",
      "Write",
      "Edit",
      "MultiEdit",
      "LS",
      "Glob",
      "Grep"
    ],
    "deny": []
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"<python-exe>\" \"C:/Users/<user>/.claude/hooks/block-iptables-save-to-rules.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"<python-exe>\" \"C:/Users/<user>/.claude/hooks/md2pdf-on-edit.py\"",
            "timeout": 130
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"<python-exe>\" \"C:/Users/<user>/.claude/cron/hooks/session-start.py\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"<python-exe>\" \"C:/Users/<user>/.claude/cron/hooks/session-end.py\""
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"<python-exe>\" \"C:/Users/<user>/.claude/cron/hooks/pre-compact.py\"",
            "timeout": 130
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "context7@claude-plugins-official": true
  },
  "language": "ru"
}
