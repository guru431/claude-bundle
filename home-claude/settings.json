{
  "env": {
    "BASH_MAX_OUTPUT_LENGTH": "15000",
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "4",
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1"
  },
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(where:*)",
      "Read",
      "Write",
      "Edit",
      "MultiEdit",
      "LS",
      "Glob",
      "Grep"
    ],
    "deny": []
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true
  },
  "language": "ru"
}
