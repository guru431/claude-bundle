FIRST_KEY=first
# Shared .env parser contract - read by tests/test_dotenv_parity.py, which
# holds the expected value of every line. Keep the BOM, the CRLF lines and
# the missing final newline: they ARE the test.

export EXPORTED=yes
  export LEAD_EXPORT=indented
SPACED = padded
QUOTED_PAD = "in quotes"   
SINGLE='single'
TABS=	tabbed	
HASH_IN_VALUE=a#b # not a comment
HASH_QUOTED="#not a comment"
EQUALS_IN_VALUE=a=b=c
WIN_PATH=C:\Program Files\Git\bin\bash.exe
NO_EXPANSION=$HOME/x
EMBEDDED_QUOTES=say "hi"
UNMATCHED="open
MIXED_QUOTES='say "hi"'
EMPTY=
EMPTY_QUOTED=""
NON_ASCII=C:\Users\Пользователь\python.exe
   # an indented comment
1BADKEY=nope
AFTER_BAD=reached
BAD-KEY=nope
КЛЮЧ=cyrillic key
NO_EQUALS_LINE
export EXPORT_NO_EQUALS
LAST_NO_NEWLINE=end